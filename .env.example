# Zeabur / local server port
PORT=3007

# LLM config
# mock: rule-based parser, no API key needed
# openai_compatible: call an OpenAI-compatible chat/completions endpoint
LLM_PROVIDER=openai_compatible
LLM_API_KEY=replace_with_your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=25

# CORS
# Same-service deployment can keep this as * for first demo.
CORS_ALLOW_ORIGINS=*
